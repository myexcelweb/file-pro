---
import MainLayout from "../layouts/MainLayout.astro";
import { renderCard, renderChips } from "../lib/tools";
import { getBuildTools } from "../lib/build-data";

// Links are fetched from Firestore at BUILD time so the HTML Google indexes
// matches the live site (falls back to the built-in list). The browser then
// keeps the list live via the Firestore SDK.
const { tools } = await getBuildTools();
const initial = tools.filter((t) => t.visible);
const site = (Astro.site?.href ?? "https://file-pro.netlify.app/").replace(/\/$/, "");

// Structured data: tells search engines this page is a list of web apps.
const itemList = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "File Pro tools by Parimal Hodar",
  numberOfItems: initial.length,
  itemListElement: initial.map((t, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "SoftwareApplication",
      name: t.name,
      url: t.url,
      description: t.description || t.features.join(". "),
      applicationCategory: t.category === "Utilities" ? "UtilitiesApplication" : "BusinessApplication",
      operatingSystem: "Web browser",
      offers: { "@type": "Offer", price: "0", priceCurrency: "INR" },
      author: { "@type": "Person", name: "Parimal Hodar", url: `${site}/about/` },
    },
  })),
});
// Initial data for the browser script, so it starts from exactly what's in the HTML.
const initialJson = JSON.stringify(initial).replace(/</g, "\\u003c");
---

<MainLayout
  title="Parimal Hodar – File Pro | Advanced Digital Tools"
  description="Official website of Parimal Hodar. Explore cutting-edge digital tools, Excel apps, PDF editors, and more by Parimal Hodar."
>
  <!-- Hero + search -->
  <section class="relative text-center pt-10 pb-8 sm:pt-16">
    <div class="pointer-events-none absolute inset-x-0 -top-16 -z-10 mx-auto h-80 max-w-4xl" style="background:radial-gradient(closest-side at 35% 50%, rgba(129,140,248,.28), transparent), radial-gradient(closest-side at 65% 45%, rgba(232,121,249,.22), transparent), radial-gradient(closest-side at 50% 60%, rgba(56,189,248,.18), transparent)"></div>
    <p class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold" style="border-color:var(--border);color:var(--muted);background:var(--surface)">
      <i class="fa-solid fa-bolt text-amber-500"></i> Free · browser-based · no sign-up
    </p>
    <h1 class="mt-5 text-4xl sm:text-5xl font-extrabold tracking-tight">
      Every tool you need,
      <span class="bg-gradient-to-r from-indigo-600 to-fuchsia-500 bg-clip-text text-transparent">one place.</span>
    </h1>
    <p class="mt-4 text-lg max-w-2xl mx-auto" style="color:var(--muted)">
      PDF editors, Excel apps, court report generators and AI utilities by Parimal Hodar. Search and jump straight to the tool you need.
    </p>

    <div class="mt-8 max-w-2xl mx-auto">
      <label class="search-box" for="tool-search">
        <i class="fa-solid fa-magnifying-glass" style="color:var(--muted)"></i>
        <input id="tool-search" type="search" placeholder="Search tools… e.g. pdf, excel, calendar" autocomplete="off" spellcheck="false" enterkeyhint="search" />
        <span class="kbd hidden sm:inline">/</span>
      </label>
    </div>
  </section>

  <!-- Recently opened -->
  <section id="tool-recent" class="mb-6" hidden>
    <div class="flex items-center justify-between mb-2">
      <h2 class="text-sm font-semibold" style="color:var(--muted)"><i class="fa-solid fa-clock-rotate-left mr-1"></i> Recently opened</h2>
      <button id="recent-clear" type="button" class="text-xs hover:underline" style="color:var(--muted)">Clear</button>
    </div>
    <div class="recent-list flex gap-2 overflow-x-auto pb-1"></div>
  </section>

  <!-- Filters -->
  <section id="tools" class="scroll-mt-24" aria-labelledby="tools-heading">
    <h2 id="tools-heading" class="sr-only">All tools</h2>
    <div class="flex flex-wrap items-center justify-between gap-3 mb-5">
      <div id="tool-chips" class="flex gap-2 overflow-x-auto pb-1 -mx-1 px-1" role="toolbar" aria-label="Filter by category" set:html={renderChips(initial)} />
      <div class="flex items-center gap-4 text-sm" style="color:var(--muted)">
        <span id="tool-count" aria-live="polite">{initial.length} of {initial.length} tools</span>
        <span id="tool-status" class="status-dot">Built-in list</span>
      </div>
    </div>

    <div id="tool-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" set:html={initial.map(renderCard).join("")} />

    <div id="tool-empty" class="text-center py-16" hidden>
      <i class="fa-regular fa-face-frown text-4xl mb-3" style="color:var(--muted)"></i>
      <p class="font-semibold">No tools match your search.</p>
      <p class="text-sm mt-1" style="color:var(--muted)">Try a different keyword or pick “All”.</p>
    </div>
  </section>
  <script type="application/json" id="tool-data" set:html={initialJson} />
  <script type="application/ld+json" set:html={itemList} />
</MainLayout>

<script>
  import "../scripts/home";
</script>
